# Copy this file to .env.local and fill in the keys when ready.
# Leaving any key empty makes the orchestrator skip that provider and
# fall back to the next one (or to the local template engine).

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Optional Upstash Redis for response caching (7-day TTL).
# When both are set, identical requests skip the LLM chain entirely and
# return the cached kit instantly (0 API call, 0 cost). Get a free REST
# Redis database at https://console.upstash.com.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
